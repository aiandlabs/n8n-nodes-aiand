{
	"name": "@aiand/n8n-nodes-aiand",
	"version": "0.1.2",
	"description": "n8n chat model node for ai&. Japan-hosted AI models. Your data stays in Japan",
	"license": "MIT",
	"homepage": "https://github.com/aiandlabs/n8n-nodes-aiand#readme",
	"keywords": [
		"n8n-community-node-package",
		"aiand",
		"llm",
		"chat-model"
	],
	"author": {
		"name": "ai&",
		"email": "support@aiand.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aiandlabs/n8n-nodes-aiand.git"
	},
	"bugs": {
		"url": "https://github.com/aiandlabs/n8n-nodes-aiand/issues"
	},
	"devEngines": {
		"packageManager": {
			"name": "npm",
			"version": ">=11.10.0",
			"onFail": "warn"
		}
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/**/*.map",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AiandApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LmChatAiand/LmChatAiand.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.53.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"@n8n/ai-node-sdk": "*",
		"n8n-workflow": "*"
	}
}
